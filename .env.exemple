CLOUDFLARE_TUNNEL_TOKEN= #Caso queira usar um cloudlfare Tunnel
NEXT_PUBLIC_API_URL= # https://sua.url/api
DATABASE_URL= # Sua url do db, neste caso, postgres
PORT=
NODE_ENV=development
VITE_API_URL=/api
VITE_USE_API=true
FEEDZ_API_KEY=
# MinIO (S3-compativel) - imagens de produtos e perfis.
# S3_ENDPOINT e host/nome do container, NAO uma URL: em producao use o nome do
# container do MinIO na rede (ex: minio), nunca o host publico. O bucket nao e
# publico - as imagens sao servidas pela aplicacao em /api/images.
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lojauster

# Limite de upload em bytes (padrao 10 MB)
MAX_UPLOAD_BYTES=10485760
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Authentik (OIDC SSO) — opcional; se vazio, o login via Authentik fica desativado ---
AUTHENTIK_ISSUER_URL= # https://authentik.suaempresa.com/application/o/<slug>/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI= # https://sua.url/api/auth/authentik/callback
VITE_AUTHENTIK_ENABLED= # "true" para mostrar o botao "Entrar com Authentik"
